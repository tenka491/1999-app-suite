// Anvil's default keymap. This file is bundled with the app and overwritten
// on update — copy entries you want to change into your own keymap instead
// (Preferences: Open Keymap) rather than editing this one.
//
// Sparse on purpose: only commands that exist so far are bound. The rest of
// the PRD's default keybinding table (§6) fills in as each milestone lands
// the command it's for.
[
	{ "keys": ["mod+shift+p"], "command": "palette.show" },
	{ "keys": ["mod+n"], "command": "file.new" },
	{ "keys": ["mod+s"], "command": "file.save" },
	{ "keys": ["mod+shift+s"], "command": "file.save_as" },
	{ "keys": ["mod+z"], "command": "edit.undo" },
	{ "keys": ["mod+shift+z"], "command": "edit.redo" },
	{ "keys": ["ctrl+y"], "command": "edit.redo", "platform": "linux" },
	{ "keys": ["mod+w"], "command": "tab.close" },
	{ "keys": ["mod+shift+t"], "command": "tab.reopen_closed" },
	{ "keys": ["ctrl+tab"], "command": "tab.next" },
	{ "keys": ["ctrl+shift+tab"], "command": "tab.prev" },
	{ "keys": ["mod+k", "mod+o"], "command": "workspace.open_folder" },
	{ "keys": ["mod+k", "mod+b"], "command": "sidebar.toggle" },
	{ "keys": ["mod+p"], "command": "goto.anything" },
	{ "keys": ["ctrl+g"], "command": "goto.line" },
	{ "keys": ["ctrl+shift+k"], "command": "edit.delete_line" },
	{ "keys": ["mod+shift+d"], "command": "edit.duplicate_line" },
	{ "keys": ["ctrl+mod+up"], "command": "edit.move_line_up", "platform": "macos" },
	{ "keys": ["ctrl+mod+down"], "command": "edit.move_line_down", "platform": "macos" },
	{ "keys": ["ctrl+shift+up"], "command": "edit.move_line_up", "platform": "linux" },
	{ "keys": ["ctrl+shift+down"], "command": "edit.move_line_down", "platform": "linux" },
	{ "keys": ["mod+/"], "command": "edit.toggle_comment" },
	{ "keys": ["mod+]"], "command": "edit.indent" },
	{ "keys": ["mod+["], "command": "edit.outdent" },
	{ "keys": ["tab"], "command": "edit.indent" },
	{ "keys": ["shift+tab"], "command": "edit.outdent" },
	{ "keys": ["mod+d"], "command": "selection.find_next_occurrence" },
	{ "keys": ["mod+k", "mod+d"], "command": "selection.skip_occurrence" },
	{ "keys": ["ctrl+mod+g"], "command": "selection.find_all", "platform": "macos" },
	{ "keys": ["alt+f3"], "command": "selection.find_all", "platform": "linux" },
	{ "keys": ["mod+shift+l"], "command": "selection.split_into_lines" },
	{ "keys": ["ctrl+shift+up"], "command": "selection.add_cursor_above", "platform": "macos" },
	{ "keys": ["ctrl+shift+down"], "command": "selection.add_cursor_below", "platform": "macos" },
	{ "keys": ["ctrl+alt+up"], "command": "selection.add_cursor_above", "platform": "linux" },
	{ "keys": ["ctrl+alt+down"], "command": "selection.add_cursor_below", "platform": "linux" },
	{ "keys": ["mod+l"], "command": "selection.select_line" },
	{ "keys": ["escape"], "command": "selection.collapse" },
	{ "keys": ["mod+f"], "command": "find.show" },
	{ "keys": ["mod+alt+f"], "command": "find.show_replace", "platform": "macos" },
	{ "keys": ["ctrl+h"], "command": "find.show_replace", "platform": "linux" },
	{ "keys": ["mod+g"], "command": "find.next", "platform": "macos" },
	{ "keys": ["f3"], "command": "find.next", "platform": "linux" },
	{ "keys": ["mod+shift+g"], "command": "find.prev", "platform": "macos" },
	{ "keys": ["shift+f3"], "command": "find.prev", "platform": "linux" },
	{ "keys": ["mod+="], "command": "view.font_size_increase" },
	{ "keys": ["mod+-"], "command": "view.font_size_decrease" },
	{ "keys": ["mod+0"], "command": "view.font_size_reset" }
]
